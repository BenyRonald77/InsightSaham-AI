# ===== InsightSaham Environment Configuration =====

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Provider: gemini | groq | openrouter
LLM_PROVIDER=gemini

# Groq API (alternative)
GROQ_API_KEY=your_groq_api_key_here

# Database
DATABASE_URL=sqlite+aiosqlite:///./insightsaham.db

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Auto-Filter Settings
MIN_PRICE=50
SUSPEND_DETECTION_DAYS=5

# Indicator Defaults
EMA_SHORT=20
EMA_MEDIUM=50
EMA_LONG=100
BB_PERIOD=20
BB_STD=2
STOCH_K=14
STOCH_D=3
STOCH_SMOOTH=3
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
VOLUME_MA_PERIOD=20
